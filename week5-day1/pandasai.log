import pandas as pd

# Execute SQL query
def execute_sql_query(sql_query: str) -> pd.DataFrame:
    """This method connects to the database, executes the sql query and returns the dataframe"""
    # SQL query to calculate average salary
    sql_query = f"SELECT AVG(Salary) AS average_salary FROM table_7720b6f43b79f9e2ad329a16df052ca7"
    return execute_sql_query(sql_query)


# Execute the function
result_df = execute_sql_query("SELECT AVG(Salary) AS average_salary FROM table_7720b6f43b79f9e2ad329a16df052ca7")

# Get the average salary from the result
average_salary = result_df['average_salary'].iloc[0]

# Create the result dictionary
result = {
    "type": "number",
    "value": average_salary
}

print(result)
